# ========================================================
# root@khandal - Git Ignore & Security Policy
# Prevent credential leakage, environment dumps & cache artifacts
# ========================================================

# Environment Variables & Secret Vaults (Strict Exclusions)
.env
.env.*
!.env.example
.envrc.local
*.env
*.key
*.pem
*.pfx
*.cert
*.id_rsa
*.id_ed25519

# Local direnv state
.direnv/

# System & OS Files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Editor & IDE Directories
.idea/
.vscode/
*.swp
*.swo
*~
*.bak

# Temporary & Cache Artifacts
*.tmp
*.temp
*.log
npm-debug.log*
yarn-debug.log*
node_modules/
dist/
build/
.cache/
security.md
